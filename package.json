{
  "name": "dsh-windows-agents",
  "version": "0.2.0",
  "private": true,
  "description": "Edit the user-global AGENTS.md that every session loads.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXMH1982/dsh-windows-agents.git"
  },
  "homepage": "https://github.com/LXMH1982/dsh-windows-agents#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents-md",
    "instructions"
  ],
  "type": "module",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
